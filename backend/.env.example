# FieldShift backend environment — copy to .env and adjust. NEVER commit .env.
# All variables are prefixed FS_ (see app/config.py).

FS_APP_NAME=fieldshift
FS_API_VERSION=v1
FS_ENGINE_VERSION=0.1.0
FS_DEBUG=false
FS_OFFLINE_MODE=true
FS_CORS_ORIGINS=["http://localhost:5173"]

# Phase 2+ (leave unset until providers are verified; secrets never committed):
# FS_NASA_POWER_API_KEY=
# FS_CACHE_DIR=backend/data/cache
